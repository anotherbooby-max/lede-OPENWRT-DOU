# Target x86_64 Generic
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y
CONFIG_TARGET_x86_64_Generic_DEVICE_generic=y

# 镜像输出：同时生成 BIOS + UEFI 双镜像，GPT分区，gz压缩，关闭XZ防UEFI循环重启
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_PAD=y
CONFIG_KERNEL_XZ=n
CONFIG_KERNEL_GZ=y

# Intel 5100 AGN iwlwifi 驱动（全部编译为模块M，防止内核panic）
CONFIG_PACKAGE_kmod-iwlwifi=m
CONFIG_PACKAGE_kmod-mac80211=m
CONFIG_PACKAGE_kmod-cfg80211=m
CONFIG_PACKAGE_kmod-iwlwifi-firmware=y
CONFIG_PACKAGE_linux-firmware-iwlwifi-5000=y

# AP无线组件：完整版hostapd，禁用wpad-mini
CONFIG_PACKAGE_hostapd=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_hostapd-utils=y
CONFIG_PACKAGE_wpa-supplicant=y
CONFIG_PACKAGE_wpad-mini=n

# LuCI 无线管理页面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-wireless=y
CONFIG_PACKAGE_luci-proto-wireless=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# 基础系统组件（保证系统可正常启动）
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwconfig=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_lsusb=y
CONFIG_PACKAGE_pciutils=y
